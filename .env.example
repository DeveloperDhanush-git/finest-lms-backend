# Copy this file to .env before running the app.
# Replace any placeholder values with valid credentials for your environment.
# If a credential does not work for you, use alternate local/service values
# or ask the app owner for the correct settings.

NODE_ENV=development
PORT=5000

# MongoDB connection string
# Example: mongodb://localhost:27017/finestlms
MONGO_URI=mongodb://localhost:27017/finestlms

# Redis connection details
# If these values fail, use your local Redis hostname/port or deployed Redis service.
REDIS_HOST=127.0.0.1
REDIS_PORT=6379

# JWT secrets used for authentication tokens
JWT_ACCESS_SECRET=your_jwt_access_secret
JWT_REFRESH_SECRET=your_jwt_refresh_secret

# Email account for sending reset emails and notifications
EMAIL_USER=youremail@example.com
EMAIL_APP_PASSWORD=your_email_app_password

# Client app URL used for email links
CLIENT_URL=http://localhost:3000

# AWS / S3 / CloudFront settings (optional if file upload is used)
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=your_aws_access_key_id
AWS_SECRET_ACCESS_KEY=your_aws_secret_access_key
AWS_BUCKET=your_s3_bucket_name

# CloudFront settings for signed URLs (optional)
CLOUDFRONT_URL=https://your-cloudfront-domain.cloudfront.net
CLOUDFRONT_KEY_PAIR_ID=your_cloudfront_key_pair_id
CLOUDFRONT_PRIVATE_KEY_PATH=/path/to/your/cloudfront-private-key.pem

# Razorpay settings for payments
RAZORPAY_KEY_ID=your_razorpay_key_id
RAZORPAY_KEY_SECRET=your_razorpay_key_secret
RAZORPAY_WEBHOOK_SECRET=your_razorpay_webhook_secret
